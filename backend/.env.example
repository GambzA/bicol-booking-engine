DATABASE_URL=postgresql+asyncpg://booking_engine:changeme@db:5432/booking_engine
SECRET_KEY=your-super-secret-key-min-32-chars-here-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
PUBLIC_AGENT_DOMAIN=localhost

# MinIO (S3-compatible local object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=booking-engine
MINIO_SECURE=false
# Public URL browsers use to load images (host-side port)
MINIO_PUBLIC_URL=http://localhost:9000
